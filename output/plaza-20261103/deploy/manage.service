[Unit]
Description=Jingyuan Plaza - Achievement Manage Proxy (localhost:8093)
Documentation=file:/opt/plaza/README-DEPLOY.md
After=network.target plaza.service
Wants=plaza.service

[Service]
Type=simple
WorkingDirectory=/opt/plaza/manage
# 凭据放在 EnvironmentFile（权限 600），不写进单元文件，避免 ps / systemctl cat 泄露
EnvironmentFile=/opt/plaza/config/manage.env
ExecStart=/usr/bin/python3.11 /opt/plaza/manage/manage_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
