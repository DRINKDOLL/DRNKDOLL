{
  "theme_name": "business-modern",
  "genre": "business-report",
  "note": "在 business-modern 主题基础上，按中文需求规格文档的阅读要求做了两项令牌覆盖：正文字体首项改为 SimSun（确保 Word eastAsia 正确）、正文与标题字号按小四/小二体系重设。所有 CSS 仍通过 var(--*) 消费，无裸值。",
  "css_variables": {
    "--typography-fontFamily-heading": "\"SimHei\", \"黑体\", sans-serif",
    "--typography-fontFamily-body": "\"SimSun\", \"宋体\", serif",
    "--typography-fontSize-coverTitle": "30pt",
    "--typography-fontSize-coverCategory": "12pt",
    "--typography-fontSize-h1": "18pt",
    "--typography-fontSize-h2": "14pt",
    "--typography-fontSize-h3": "12pt",
    "--typography-fontSize-body": "12pt",
    "--typography-fontSize-small": "10.5pt",
    "--typography-lineHeight-body": "1.6",
    "--typography-lineHeight-heading": "1.4",
    "--typography-fontWeight-heading": "700",
    "--typography-fontWeight-body": "400",
    "--color-primary": "#1565C0",
    "--color-heading": "#1A237E",
    "--color-text": "#212121",
    "--color-textSecondary": "#616161",
    "--color-divider": "#E0E0E0",
    "--color-background": "#FFFFFF",
    "--color-surface": "#F5F7FA",
    "--color-accent": "#00897B",
    "--spacing-paragraph": "0.55em",
    "--spacing-sectionGap": "1.6em",
    "--layout-marginTop": "2.5cm",
    "--layout-marginBottom": "2.0cm",
    "--layout-marginLeft": "2.5cm",
    "--layout-marginRight": "2.5cm",
    "--layout-pageSize": "A4",
    "--layout-maxContentWidth": "160mm"
  }
}
