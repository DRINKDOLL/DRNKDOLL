# ===== 运行时 / 构建产物（体积大、非源代码） =====
# JDK 发行包（整目录，约 1GB）
output/plaza-20261103/halo-lab/tools/
output/plaza-20261103/halo-lab/jars/*.jar
output/plaza-20261103/halo-lab/jars/*.jar.bak-*

# Halo 插件 jar 与数据库文件
output/plaza-20261103/halo-cn/workdir/plugins/*.jar
output/plaza-20261103/halo-cn/workdir/db/
output/plaza-20261103/halo-cn/archive/

# Lucene 搜索索引（运行时产物，随搜索变化）
output/plaza-20261103/halo-cn/workdir/indices/

# halo-lab 实验插件与运行产物
output/plaza-20261103/halo-lab/work/
output/plaza-20261103/halo-lab/logs/
output/plaza-20261103/halo-lab/evidence/

# 部署打包产物
output/plaza-20261103/deploy/pkg/
output/plaza-20261103/deploy/*.tar.gz

# jar 解压产物
output/plaza-20261103/halo-lab/jars/BOOT-INF/

# Halo 运行时附件（上传内容）
output/plaza-20261103/halo-cn/workdir/attachments/

# 演示文稿工具缓存/日志
output/成果展示广场演示/.cache/
output/成果展示广场演示/.slidep/

# 日志
*.log
*.log.*.gz
**/logs/

# Node 依赖
**/node_modules/

# ===== 密钥 / 凭据（严禁提交） =====
# 部署用 SSH 私钥
output/plaza-20261103/deploy/ssh/
# 含明文管理员口令的环境文件（login.env / manage.env / gateway.env）
output/plaza-20261103/deploy/*.env
# Halo 站点密钥库与 PAT 私钥
output/plaza-20261103/halo-cn/workdir/keys/
# 网关内部签名密钥（兜底读取）
output/plaza-20261103/halo-cn/gateway/configs/secrets.json

# 部署打包产物（pkg3 内含 halo.jar 134MB）
output/plaza-20261103/deploy/pkg3/

# Python 缓存
__pycache__/
*.pyc

# 文档流水线 / 页面抓取等工具临时产物
output/plaza-20261103/halo-cn/output/
output/plaza-20261103/deploy/loc.html
output/plaza-20261103/deploy/rem.html

# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 会话/临时文件 =====
.output/
*.tmp
*.swp
